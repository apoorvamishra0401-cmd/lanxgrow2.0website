{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/interview-prep",
      "destination": "/interview-prep.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/smart-ai",
      "destination": "/seo-pages/smart-ai.html"
    },
    {
      "source": "/about",

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/interview-prep",
      "destination": "/pages/interview-prep-content.html"
    },
    {
      "source": "/(smart-ai/review|app-preview|get-started|signin|signup|consent|forgot-password|reset-password|auth-callback|placeholder|account)",
      "destination": "/app-shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/interview-prep.html",
      "destination": "/interview-prep",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/get-started",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(signin|signup|consent|forgot-password|reset-password|auth-callback|placeholder|account|app-preview|smart-ai/review)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}

    {
      "source": "/activate",
      "destination": "/app.html"
    },
    {
      "source": "/career/interview",
      "destination": "/app.html"
    },
    {
      "source": "/guest/:audience",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/smart-ai/review",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://lanxgrow-app-apoorvamishra0401-cmds-projects.vercel.app/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://lanxgrow-app-apoorvamishra0401-cmds-projects.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "https://lanxgrow-app-apoorvamishra0401-cmds-projects.vercel.app/auth",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://lanxgrow-app-apoorvamishra0401-cmds-projects.vercel.app/auth",
      "permanent": false
    },
    {
      "source": "/get-started",
      "destination": "https://lanxgrow-app-apoorvamishra0401-cmds-projects.vercel.app/",
      "permanent": false
    },
    {
      "source": "/founder-homepage.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/interview-prep.html",
      "destination": "/interview-prep",
      "permanent": true
    },
    {
      "source": "/interview-preparation",
      "destination": "/interview-prep",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/seo-pages/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",

# LanXgrow website — optional configuration
#
# Every value here is optional. With this file absent, or with the values left
# empty, the launch build runs without accounts and with the enquiry form
# inactive: sign-in shows an informational page, the contact form's controls are
# disabled, and the Privacy Notice describes exactly that.
#
# Copy this file to `.env.local` (git-ignored) and fill in what you need.
# Only `VITE_*` variables reach the browser bundle, so never put a secret here.

# ---------------------------------------------------------------------------
# Authentication — Supabase Auth, email one-time codes
# ---------------------------------------------------------------------------
# From Supabase: Project Settings → API. The URL and the publishable/anon key
# are both public by design (the anon key is protected by row-level security),
# so shipping them in a browser bundle is expected. Never use a service-role
# key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave as "false" unless a paid SMS provider is configured in Supabase.
# SMS delivery is not available on a free plan, so phone sign-in stays honestly
# disabled until this is "true".
VITE_AUTH_PHONE_ENABLED=false

# ---------------------------------------------------------------------------
# Contact form delivery — optional
# ---------------------------------------------------------------------------
# Any HTTPS endpoint that accepts a JSON POST: a free form service, or your own
# serverless function. While this is empty the enquiry form stays inactive and
# says so on the page rather than implying delivery.
# Plain HTTP is accepted only for loopback addresses (development stubs).
VITE_CONTACT_ENDPOINT=
